  "blocks": [
    {
      "type": "callout",
      "kind": "tip",
      "title": "After this PDF you can",
      "bullets": [
        "choose between por and para in all main uses",
        "use verbs with fixed prepositions (depender de, soñar con, fijarse en, ...)",
        "use the personal a correctly",
        "avoid dequeísmo and queísmo (pienso que, me doy cuenta de que)"
      ]
    },
