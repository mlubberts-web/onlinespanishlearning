      "type": "h1",
      "text": "7. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Ayer tení mucho trabajo.",
          "Ayer tuve mucho trabajo.",
          "Tener has the stem tuv- in the preterite."
        ],
        [
          "Hací la cena.",
          "Hice la cena.",
          "The stem of hacer is hic-, and the él form is hizo."
        ],
        [
          "Ellos dijieron la verdad.",
          "Ellos dijeron la verdad.",
          "j-stem verbs take -eron, not -ieron."
        ],
        [
          "Fué a Madrid.",
          "Fue a Madrid.",
          "One-syllable forms (fue, fui, vio, vi, dio, di) have no accent."
        ],
        [
          "Yo anduvé por el parque.",
          "Yo anduve por el parque.",
          "Irregular yo forms end in -e without an accent."
        ],
        [
          "Ella querió venir.",
          "Ella quiso venir.",
          "Querer has the stem quis- in the preterite."
        ],
        [
          "Trajieron la comida.",
          "Trajeron la comida.",
          "traer is a j-stem verb: trajeron."
        ],
        [
          "No puedí abrir la puerta.",
          "No pude abrir la puerta.",
          "Poder has the stem pud- in the preterite."
        ],
        [
          "Ayer hice a Madrid.",
          "Ayer fui a Madrid.",
          "Hacer is not used for going. Ir + a + place gives fui a Madrid."
        ]
      ]
    },
