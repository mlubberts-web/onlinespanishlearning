    {
      "type": "callout",
      "kind": "tip",
      "title": "aunque: fact or maybe?",
      "text": "<b>Aunque + indicative</b> = a fact you know: <i>Aunque llueve, voy.</i> (It is raining, but I go.) <b>Aunque + subjunctive</b> = not known or not important: <i>Aunque llueva, iré.</i> (Even if it rains, I will go.)"
    },
