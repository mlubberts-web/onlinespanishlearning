    {
      "type": "callout",
      "kind": "warn",
      "title": "porque / por qué / porqué / por que",
      "bullets": [
        "<b>porque</b> (one word) = because: <i>No vino porque estaba enfermo.</i>",
        "<b>por qué</b> (two words, accent) = why in a question: <i>¿Por qué no viniste?</i>",
        "<b>el porqué</b> = the reason (noun): <i>No sé el porqué.</i>",
        "<b>por que</b> = preposition + relative: <i>La razón por que...</i> (rare)"
      ]
    },
