      "type": "h1",
      "text": "7. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Cuando llegaré, te llamo.",
          "Cuando llegue, te llamo.",
          "Subjunctive after cuando for the future."
        ],
        [
          "Voy para que verte.",
          "Voy para verte.",
          "Same subject: para + infinitive."
        ],
        [
          "Te llamo para que vienes.",
          "Te llamo para que vengas.",
          "para que + subjunctive."
        ],
        [
          "Salimos antes de que llueve.",
          "Salimos antes de que llueva.",
          "antes de que: always subjunctive."
        ],
        [
          "Debido que llovía, me quedé.",
          "Debido a que llovía, me quedé.",
          "debido a (que)."
        ],
        [
          "Porque no viniste?",
          "¿Por qué no viniste?",
          "Question: por qué."
        ],
        [
          "No creo que tiene razón.",
          "No creo que tenga razón.",
          "no creer que + subjunctive."
        ],
        [
          "Aunque llueve, iré mañana.",
          "Aunque llueva, iré mañana.",
          "Unknown future event: subjunctive."
        ],
        [
          "Estoy cansado, pero por eso me acuesto.",
          "Estoy cansado, por eso me acuesto.",
          "Do not mix pero and por eso."
        ]
      ]
    },
