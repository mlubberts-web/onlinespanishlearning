      "text": "5. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Es tan fuerte que un toro.",
          "Es tan fuerte como un toro.",
          "tan + como for comparison."
        ],
        [
          "Lo vi con mis ojos propios.",
          "Lo vi con mis propios ojos.",
          "propio goes before the noun."
        ],
        [
          "Es muy único.",
          "Es único.",
          "único does not take muy in careful style."
        ],
        [
          "Subir arriba.",
          "Subir.",
          "avoid the redundant arriba."
        ],
        [
          "Salir afuera.",
          "Salir.",
          "redundant."
        ],
        [
          "Cuesta un ojo de cara.",
          "Cuesta un ojo de la cara.",
          "the fixed form has la."
        ],
        [
          "Llueve a cantaros.",
          "Llueve a cántaros.",
          "accent on cántaros."
        ]
      ]
