        "-ar  (hablar)",
        "-er  (comer)",
        "-ir  (vivir)"
      ],
      "rows": [
        [
          "yo",
          "-é",
          "-í",
          "-í"
        ],
        [
          "tú",
          "-aste",
          "-iste",
          "-iste"
        ],
        [
          "él / ella / usted",
          "-ó",
          "-ió",
          "-ió"
        ],
        [
          "nosotros / nosotras",
          "-amos",
          "-imos",
          "-imos"
        ],
        [
          "vosotros / vosotras",
          "-asteis",
          "-isteis",
          "-isteis"
        ],
