      "text": "6. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Mañana haceré la cena.",
          "Mañana haré la cena.",
          "hacer has the stem har-."
        ],
        [
          "Yo no poderé venir.",
          "Yo no podré venir.",
          "poder has the stem podr-."
        ],
        [
          "Ellos tenerán tiempo.",
          "Ellos tendrán tiempo.",
          "tener has the stem tendr-."
        ],
        [
          "Mañana hablare con él.",
          "Mañana hablaré con él.",
          "The yo form needs the accent: hablaré."
        ],
        [
          "Si tendré tiempo, iré.",
          "Si tengo tiempo, iré.",
          "After si (if) use the present, not the future."
        ],
        [
          "Dijo que vendrá a las ocho.",
          "Dijo que vendría a las ocho.",
          "Reported speech in the past needs the conditional."
        ],
        [
          "Yo gustaría un café.",
          "Me gustaría un café.",
          "gustar needs the indirect pronoun: me gustaría."
        ],
        [
          "Yo sabré la respuesta ayer.",
          "Supe la respuesta ayer.",
          "The future is not used for the past. Use the preterite."
        ],
        [
          "Será tres horas.",
          "Serán las tres.",
          "Hours are plural: serán las tres (probably three o'clock)."
        ]
      ]
    },
