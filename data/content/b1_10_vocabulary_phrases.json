      ],
      "items": [
        {
          "q": "El ______ de mi trabajo es de 2000 euros al mes.",
          "hint": "salary",
          "a": "sueldo",
          "full": "El sueldo de mi trabajo es de 2000 euros al mes."
        },
        {
          "q": "Mañana tengo un ______ de matemáticas.",
          "hint": "exam",
          "a": "examen",
          "full": "Mañana tengo un examen de matemáticas."
        },
        {
          "q": "Hay que ______ el plástico para cuidar el medio ambiente.",
          "hint": "to recycle",
          "a": "reciclar",
          "full": "Hay que reciclar el plástico para cuidar el medio ambiente."
        },
        {
          "q": "Mi jefe me ______ ayer: ya no tengo trabajo.",
          "hint": "to fire (preterite)",
          "a": "despidió",
          "full": "Mi jefe me despidió ayer: ya no tengo trabajo."
        },
        {
          "q": "Estoy ______ polvo después del examen.",
          "hint": "exhausted",
          "a": "hecho",
          "full": "Estoy hecho polvo después del examen."
        },
        {
          "q": "Esta película ______ la pena.",
          "hint": "to be worth it",
          "a": "vale",
          "full": "Esta película vale la pena."
        },
        {
          "q": "Ella está ______ y espera un bebé.",
          "hint": "pregnant (not embarrassed!)",
          "a": "embarazada",
          "full": "Ella está embarazada y espera un bebé."
        },
        {
          "q": "Hoy ______ a cántaros.",
          "hint": "to rain (3rd person)",
          "a": "llueve",
          "full": "Hoy llueve a cántaros."
        },
        {
          "q": "Mi hermano es muy ______: nunca cambia de opinión.",
          "hint": "stubborn",
          "a": "testarudo",
          "full": "Mi hermano es muy testarudo: nunca cambia de opinión."
        },
        {
          "q": "Los jóvenes votaron en las ______.",
          "hint": "elections",
