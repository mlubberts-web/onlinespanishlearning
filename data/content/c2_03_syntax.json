    {
      "type": "h1",
      "text": "6. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Ayer vi yo la película.",
          "Ayer vi la película.",
          "no Dutch-style inversion."
        ],
        [
          "Era un hombre grande, todos lo admiraban. (great)",
          "Era un gran hombre, todos lo admiraban.",
          "gran before noun = great."
        ],
        [
          "Es un pobre hombre, no tiene dinero. (poor)",
          "Es un hombre pobre, no tiene dinero.",
          "pobre after = without money."
        ],
        [
          "Hecho las compras, volvimos.",
          "Hechas las compras, volvimos.",
          "participle agrees with the noun."
        ],
        [
          "Fue Juan que lo hizo.",
          "Fue Juan quien lo hizo.",
          "persons: quien."
        ],
        [
          "Qué bonito que es!",
          "¡Qué bonito es!",
          "no que after the adjective; add ¡ at the start."
        ],
        [
          "Lo libro compré ayer.",
          "El libro lo compré ayer.",
          "lo is the pronoun, not the article."
        ]
      ]
    },
    {
