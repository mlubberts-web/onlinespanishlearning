      "type": "h1",
      "text": "6. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Se vende pisos.",
          "Se venden pisos.",
          "plural thing: plural verb."
        ],
        [
          "Se buscan a los secretarios.",
          "Se busca a los secretarios.",
          "personal a: singular."
        ],
        [
          "Se habla muchas lenguas.",
          "Se hablan muchas lenguas.",
          "plural thing: plural verb."
        ],
        [
          "Fue construido por se los romanos.",
          "Fue construido por los romanos.",
          "ser + por, never se + por."
        ],
        [
          "La reunión fue llevada a cabo.",
          "La reunión se llevó a cabo.",
          "natural with se."
        ],
        [
          "Hacer un decisión.",
          "Tomar una decisión.",
          "collocation: tomar, feminine."
        ],
        [
          "Poner atención a.",
          "Prestar atención a.",
          "collocation: prestar."
        ],
        [
          "Dar hincapié.",
          "Hacer hincapié.",
          "collocation: hacer."
        ],
        [
          "Le lo di.",
          "Se lo di.",
          "le + lo becomes se lo."
        ]
      ]
    },
