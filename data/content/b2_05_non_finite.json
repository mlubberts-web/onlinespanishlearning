      "type": "h1",
      "text": "4. Infinitive, gerund or que-clause?"
    },
    {
      "type": "table",
      "style": "plain",
      "widths": [
        5.0,
        6.0,
        6.0
      ],
      "head": [
        "Situation",
        "Use",
        "Example"
      ],
      "rows": [
        [
          "Same subject, purpose",
          "para + inf.",
          "Estudio para aprobar."
        ],
        [
          "Different subject, purpose",
          "para que + subj.",
          "Te lo explico para que lo entiendas."
        ],
        [
          "Same subject, time",
          "al / antes de + inf.",
          "Al salir, apagó la luz."
        ],
        [
          "Different subject, time",
          "cuando / antes de que + verb",
          "Cuando salí, llovía."
        ],
        [
          "Same subject, feeling",
          "de + inf.",
          "Me alegro de verte."
        ],
        [
          "Different subject, feeling",
          "de que + subj.",
          "Me alegro de que vengas."
        ],
        [
          "Manner / means",
          "gerund",
          "Aprendió trabajando."
        ]
      ]
    },
    {
      "type": "h1",
      "text": "5. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Al llegando, llamé.",
          "Al llegar, llamé.",
          "al + infinitive, never gerund."
        ],
        [
          "Salió sin diciendo nada.",
          "Salió sin decir nada.",
          "sin + infinitive."
        ],
        [
          "Estoy cansada de trabajando.",
          "Estoy cansada de trabajar.",
          "Preposition + infinitive."
        ],
        [
          "Una caja conteniendo libros.",
          "Una caja que contiene libros.",
          "Gerund cannot modify a noun."
        ],
        [
          "Terminado las clases, salimos.",
          "Terminadas las clases, salimos.",
          "Participle agrees with the noun."
        ],
        [
          "Después de llegando, comió.",
          "Después de llegar, comió.",
          "After a preposition: infinitive."
        ],
        [
          "Me alegro de que verte.",
          "Me alegro de verte.",
          "Same subject: infinitive."
        ],
        [
          "Quiero que yo salga.",
          "Quiero salir.",
          "Same subject: infinitive."
        ],
        [
          "Se sentó, abriendo el libro.",
          "Se sentó y abrió el libro.",
          "Following actions need a second verb."
        ]
      ]
    },
