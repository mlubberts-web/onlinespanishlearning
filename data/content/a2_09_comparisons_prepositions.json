          "Patience is needed."
        ],
        [
          "se puede / no se puede",
          "Aquí no se puede fumar.",
          "You can't smoke here."
        ],
        [
          "está prohibido + infinitive",
          "Está prohibido aparcar aquí.",
          "Parking is forbidden here."
        ]
      ]
