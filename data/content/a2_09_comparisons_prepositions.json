      "type": "h1",
      "text": "7. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Es más grande de mi casa.",
          "Es más grande que mi casa.",
          "Comparisons use que. Use de only before a number."
        ],
        [
          "Es tan alto que su padre.",
          "Es tan alto como su padre.",
          "tan ... como, never tan ... que (that means \"so ... that\")."
        ],
        [
          "Tengo tan libros como tú.",
          "Tengo tantos libros como tú.",
          "Before a noun use tanto, which agrees."
        ],
        [
          "Es el más bueno.",
          "Es el mejor.",
          "bueno has an irregular comparative: mejor."
        ],
        [
          "Nadie no habla.",
          "Nadie habla.",
          "Before the verb there is no \"no\"."
        ],
        [
          "No tengo algún problema.",
          "No tengo ningún problema.",
          "A negative sentence needs ningún, not algún."
        ],
        [
          "Estudio por aprender.",
          "Estudio para aprender.",
          "para + infinitive for purpose."
        ],
        [
          "Gracias para tu ayuda.",
          "Gracias por tu ayuda.",
          "Thanks FOR something: por."
        ],
        [
          "Pienso de ti.",
          "Pienso en ti.",
          "pensar takes en."
        ],
        [
          "Espero por el autobús.",
          "Espero el autobús.",
          "esperar needs no preposition."
        ]
      ]
    },
