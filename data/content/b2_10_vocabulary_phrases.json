    {
      "type": "h1",
      "text": "8. Confusing words"
    },
    {
      "type": "table",
      "style": "plain",
      "widths": [
        4.4,
        6.0,
        6.6
      ],
      "head": [
        "Word",
        "Means",
        "Do not confuse with"
      ],
      "rows": [
        [
          "ahora / en seguida",
          "now / at once",
          "ahora mismo = right now"
        ],
        [
          "pedir / preguntar",
          "to ask for / to ask a question",
          "Le pedí dinero. Le pregunté la hora."
        ],
        [
          "saber / conocer",
          "to know (fact) / to know (person, place)",
          "Sé la respuesta. Conozco Madrid."
        ],
        [
          "llevar / traer",
          "to take / to bring",
          "Llévalo allí. Tráelo aquí."
        ],
        [
          "ir / venir",
          "to go / to come",
          "Voy allí. Vengo aquí."
        ],
        [
          "quedar / quedarse",
          "to meet / to stay",
          "Quedamos a las ocho. Me quedo en casa."
        ],
        [
          "hacer / dejar",
          "to make / to let",
          "Me hizo reír. Me dejó entrar."
        ],
        [
          "tiempo / vez / rato",
          "time (duration) / occasion / while",
          "Tengo tiempo. Una vez. Un rato."
        ],
        [
          "sentir / sentirse",
          "to feel (sth) / to feel (state)",
          "Siento frío. Me siento bien."
        ],
        [
          "pensar / creer",
          "to think / to believe",
          "Pienso en ti. Creo que sí."
        ]
      ]
    },
