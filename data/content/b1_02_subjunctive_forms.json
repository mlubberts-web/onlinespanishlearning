    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Quiero que hablas.",
          "Quiero que hables.",
          "After querer que, use the subjunctive, not the present."
        ],
        [
          "Quiero que vienes.",
          "Quiero que vengas.",
          "venir: the yo form is vengo, so the subjunctive is venga."
        ],
        [
          "Espero que es feliz.",
          "Espero que sea feliz.",
          "ser is irregular: sea, seas, sea ..."
        ],
        [
          "Quiero que vas.",
          "Quiero que vayas.",
          "ir is irregular: vaya, vayas, vaya ..."
        ],
        [
          "Quiero que haces la cena.",
          "Quiero que hagas la cena.",
          "hacer: hago gives haga."
        ],
        [
          "Espero que tienes tiempo.",
          "Espero que tengas tiempo.",
          "tener: tengo gives tenga."
        ],
        [
          "Es importante que sepes.",
          "Es importante que sepas.",
          "saber: sepa, sepas, sepa ..."
        ],
        [
          "Quiero que dormamos.",
          "Quiero que durmamos.",
          "-ir verbs change o to u in nosotros and vosotros."
        ],
        [
