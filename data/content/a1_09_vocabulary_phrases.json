    { "type": "h1", "text": "12. Spain or Latin America?" },
    {
      "type": "p",
      "text": "This course uses Spain Spanish. You will meet the words in the right-hand column in films, series and apps from Latin America."
    },
    {
      "type": "table",
      "style": "plain",
