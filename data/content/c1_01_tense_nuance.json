    {
      "type": "callout",
      "kind": "spain",
      "title": "Spain vs Latin America",
      "text": "In Spain the <b>present perfect</b> covers anything connected to the present: <i>Esta mañana he desayunado fuerte.</i> In much of Latin America the preterite replaces it: <i>Esta mañana desayuné fuerte.</i>"
    },
