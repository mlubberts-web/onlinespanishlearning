      "text": "7. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Ayer he comido tarde.",
          "Ayer comí tarde.",
          "Finished time word: preterite."
        ],
        [
          "Esta mañana comí tarde. (in Spain)",
          "Esta mañana he comido tarde.",
          "Unfinished period: perfect."
        ],
        [
          "Conocía a Ana ayer.",
          "Conocí a Ana ayer.",
          "met: preterite."
        ],
        [
          "Ayer sabía la noticia.",
          "Ayer supe la noticia.",
          "found out: preterite."
        ],
        [
          "Estará las tres.",
          "Serán las tres.",
          "Time uses ser."
        ],
        [
          "Habrá sido las tres.",
          "Serían las tres.",
          "Past guess: conditional."
        ],
        [
          "Quise saber la verdad (I wanted to know).",
          "Quería saber la verdad.",
          "quise = I tried."
        ],
        [
          "Si tendría dinero, ...",
          "Si tuviera dinero, ...",
          "No conditional after si."
        ],
        [
          "Apenas llegó, hubo salido.",
          "Apenas hubo llegado, salió.",
          "pretérito anterior: first action."
        ]
      ]
