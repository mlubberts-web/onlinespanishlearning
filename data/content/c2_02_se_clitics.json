    {
      "type": "h1",
      "text": "6. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Se me cayó los vasos.",
          "Se me cayeron los vasos.",
          "the verb agrees with the thing."
        ],
        [
          "Le lo di.",
          "Se lo di.",
          "le + lo becomes se lo."
        ],
        [
          "Te se ha caído.",
          "Se te ha caído.",
          "se comes first."
        ],
        [
          "A María la dije la verdad.",
          "A María le dije la verdad.",
          "no laísmo."
        ],
        [
          "Dame lo.",
          "Dámelo.",
          "pronouns attach to the imperative; add the accent."
        ],
        [
          "No lo digas me.",
          "No me lo digas.",
          "negative imperative: pronouns before."
        ],
        [
          "Sabes qué difícil es esto.",
          "Sabes lo difícil que es esto.",
          "after saber, lo + adjective + que."
        ]
      ]
    },
