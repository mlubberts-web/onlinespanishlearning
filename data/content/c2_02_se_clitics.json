    {
      "type": "h1",
      "text": "3. Clitic doubling and position"
    },
    {
      "type": "table",
      "style": "plain",
      "widths": [
        5.0,
        6.4,
        5.6
      ],
      "head": [
        "Rule",
        "Example",
        "Note"
      ],
      "rows": [
        [
          "indirect object doubled",
          "Le di el libro a Ana.",
          "le is practically obligatory"
        ],
        [
          "a mí / a ti: emphasis",
          "A mí me gusta el cine.",
          "usual with gustar-verbs"
        ],
        [
          "direct object, emphatic",
          "La vi a ella, no a él.",
          "doubling for contrast"
        ],
        [
          "before conjugated verb",
          "Te lo explico mañana.",
          "order: se, te/me/nos/os, lo"
        ],
        [
          "attached to infinitive",
          "Quiero explicártelo.",
          "or Te lo quiero explicar"
        ],
        [
          "attached to gerund",
          "Estoy preparándolo.",
          "or Lo estoy preparando"
        ],
        [
          "attached to imperative",
          "Dámelo ahora mismo.",
          "accent mark added"
        ],
        [
          "negative imperative",
          "No me lo des.",
          "pronouns come before the verb"
        ]
      ]
    },
    {
      "type": "callout",
      "kind": "spain",
      "title": "Order of pronouns",
      "text": "Fixed order: <b>se</b> + <b>2nd person</b> (te, os) + <b>1st person</b> (me, nos) + <b>3rd person</b> (lo, la, le). So <i>Se te ha caído</i>, but never *te se ha caído."
    },
