          "have done so far",
          "Llevo leídas cien páginas.",
          "I have read a hundred pages so far."
        ],
        [
          "dejar + participle",
          "leave in a state",
          "Dejó la puerta abierta.",
          "He left the door open."
        ],
        [
          "dar por + participle",
          "consider",
          "Lo dieron por perdido.",
          "They gave it up for lost."
        ],
        [
          "estar + participle",
          "state",
          "Está cansado.",
          "He is tired."
        ],
        [
          "ir + participle",
          "in a state (position)",
          "Va vestido de negro.",
          "He is dressed in black."
        ],
        [
          "quedar + participle",
          "end up in a state",
          "Quedó sorprendido.",
          "He was left surprised."
        ]
      ]
    },
    {
      "type": "bullets",
      "items": [
        "In <b>tener / llevar / dejar + participle</b> the participle <b>agrees</b> with the object: <i>Tengo escritas tres cartas. Dejó cerradas las ventanas.</i>"
      ]
    },
