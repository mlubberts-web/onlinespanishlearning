    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Estudio dos años.",
          "Llevo dos años estudiando.",
          "Duration: llevar + gerund."
        ],
        [
          "Acabo llegar.",
          "Acabo de llegar.",
          "acabar de + infinitive."
        ],
        [
          "Vuelvo llamar.",
          "Vuelvo a llamar.",
          "volver a + infinitive."
        ],
        [
          "Debe estar en casa (probability).",
          "Debe de estar en casa.",
          "Probability: deber de."
        ],
        [
          "Hay que yo estudiar.",
          "Tengo que estudiar.",
          "hay que is impersonal."
        ],
        [
          "Sigo no entendiendo.",
          "Sigo sin entenderlo.",
          "seguir sin + infinitive."
        ],
        [
          "Tengo escrito tres cartas.",
          "Tengo escritas tres cartas.",
          "Participle agrees with the object."
        ],
        [
          "Dejé fumando.",
          "Dejé de fumar.",
          "dejar de + infinitive."
        ],
        [
          "Estoy yendo a salir.",
          "Voy a salir.",
          "ir a is not used in the progressive."
        ]
