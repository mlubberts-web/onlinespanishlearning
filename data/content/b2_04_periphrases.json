        "Meaning",
        "Example",
        "English"
      ],
      "rows": [
        [
          "tener que + inf.",
          "strong personal obligation",
          "Tengo que estudiar.",
          "I have to study."
        ],
        [
          "haber que + inf.",
          "general obligation (impersonal)",
          "Hay que estudiar.",
          "One has to study."
        ],
        [
          "deber + inf.",
          "moral duty",
          "Debes llamar a tu madre.",
          "You should call your mother."
        ],
        [
          "deber de + inf.",
          "probability",
          "Debe de estar en casa.",
          "He must be at home."
        ],
        [
          "haber de + inf.",
          "formal obligation",
          "He de reconocer que...",
          "I must admit that..."
        ],
        [
          "poder + inf.",
          "ability, possibility",
          "Puede llover.",
          "It may rain."
        ]
      ]
