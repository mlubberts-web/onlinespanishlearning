          "Dime cuando llegas.",
          "Dime cuándo llegas.",
          "indirect question: cuándo."
        ],
        [
          "Que hora es?",
          "¿Qué hora es?",
          "opening ¿ and accent."
        ],
        [
          "Haber qué pasa.",
          "A ver qué pasa.",
