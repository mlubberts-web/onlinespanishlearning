      "type": "h1",
      "text": "5. Spelling trouble spots"
    },
    {
      "type": "table",
      "style": "plain",
      "widths": [
        4.6,
        6.2,
        6.2
      ],
      "head": [
        "Issue",
        "Rule",
        "Examples"
      ],
      "rows": [
        [
          "b / v",
          "same sound; learn the word",
          "vaca, baca; haber, haver (wrong)"
        ],
        [
          "g / j",
          "ge, gi and je, ji sound the same: learn the word",
          "gente, gigante; jefe, jirafa"
        ],
        [
          "gu / gü",
          "gue, gui = /g/; güe, güi = /gw/",
          "guitarra, pingüino, vergüenza"
        ],
        [
          "c / qu / k",
          "ca, co, cu; que, qui",
          "casa, queso, kilo"
        ],
        [
          "c / z",
          "za, zo, zu; ce, ci",
          "zapato, cena, cinco"
        ],
        [
          "-cción vs -ción",
          "direct stem in -ct- keeps cc",
          "acción, dirección, instrucción"
        ],
        [
          "mp / mb / nv",
          "m before p and b",
          "campo, cambio, envío, invierno"
        ],
        [
          "h silent",
          "no sound; check the word",
          "hablar, hacer, hoy, huevo, ahora"
        ],
        [
          "ll / y",
          "differs by region, spelling by word",
          "llave, yo, calle, playa"
        ],
        [
          "x / s",
          "x = /ks/ or /s/",
          "examen, extra, explicar, sexto"
        ]
      ]
    },
