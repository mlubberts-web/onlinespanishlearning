        ],
        [
          "No es caro si no barato.",
          "No es caro sino barato.",
          "sino = but."
        ],
        [
          "Si no vienes, sino me enfado.",
          "Si no vienes, me enfado.",
          "si no = if not."
        ],
        [
          "Mi hermano, vive en Madrid.",
          "Mi hermano vive en Madrid.",
          "no comma subject + verb."
        ],
        [
