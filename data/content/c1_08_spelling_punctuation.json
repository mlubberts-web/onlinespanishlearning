          "¿Qué hora es?"
        ],
        [
          "¡ ... !",
          "opening and closing",
          "¡Qué bien!"
        ],
        [
          "comma (vocative)",
          "before and after",
          "Ana, ven aquí. Ven, Ana, ahora."
        ],
        [
          "comma (apposition)",
          "around it",
          "Madrid, la capital, es grande."
        ],
        [
          "comma (list)",
          "between items, not before y",
          "Compré pan, leche y huevos."
        ],
        [
          "comma (subordinate first)",
          "after it",
          "Cuando llegues, llámame."
        ],
        [
          "comma (connector)",
          "after it",
          "Sin embargo, no vino."
        ],
        [
          "no comma",
          "never between subject and verb",
          "Mi hermano vive en Madrid."
        ],
        [
          "semicolon",
          "between long related clauses",
          "Unos viven; otros sobreviven."
        ],
        [
          "colon",
          "after greetings, before lists, quotes",
          "Querida Ana: te escribo ..."
        ],
        [
          "raya (—)",
          "for dialogue",
          "—¿Vienes? —No."
        ],
        [
          "comillas (« » or \" \")",
          "quotations, titles",
          "«No lo sé», dijo."
