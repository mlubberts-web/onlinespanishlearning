        "*eras*",
        "*era*",
        "*éramos*",
        "*erais*",
        "*eran*"
      ],
      "examples": [
        [
          "Era muy tímido de niño.",
          "I was very shy as a child."
        ],
        [
          "¿Eras feliz en el colegio?",
          "Were you happy at school?"
