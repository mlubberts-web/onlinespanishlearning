    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Cuando era niño, jugué al fútbol cada día.",
          "Cuando era niño, jugaba al fútbol cada día.",
          "A repeated habit in the past takes the imperfect."
        ],
        [
          "Siempre fui a la playa en verano.",
          "Siempre iba a la playa en verano.",
          "siempre + a repeated past action: imperfect."
        ],
        [
          "Nosotros hablabamos mucho.",
          "Nosotros hablábamos mucho.",
          "The nosotros form of -ar verbs has an accent: hablábamos."
        ],
        [
          "Yo ía al colegio.",
          "Yo iba al colegio.",
          "Ir uses -ba endings in the imperfect: iba, ibas, iba."
        ],
        [
          "Yo vía la tele.",
          "Yo veía la tele.",
          "Ver keeps its e: veía, veías, veía."
        ],
        [
          "Yo piensaba en ti.",
          "Yo pensaba en ti.",
          "The imperfect has no stem change."
        ],
        [
          "Era las tres.",
          "Eran las tres.",
          "Plural for every hour except one: Era la una, Eran las dos."
        ],
        [
          "Yo era diez años.",
          "Yo tenía diez años.",
          "Age uses tener, not ser."
        ],
        [
          "Él comíba mucho.",
          "Él comía mucho.",
          "-er and -ir verbs take -ía, never -iba."
        ]
      ]
    },
