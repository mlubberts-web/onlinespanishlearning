      "type": "mistakes",
      "rows": [
        [
          "Lo echo de menos tú.",
          "Te echo de menos.",
          "echar de menos: direct object."
        ],
        [
          "Me dormí el libro.",
          "Me dormí leyendo el libro.",
          "dormirse = fall asleep."
        ],
        [
          "Me di cuenta que era tarde.",
          "Me di cuenta de que era tarde.",
          "darse cuenta DE que."
        ],
        [
          "Metí el pie.",
          "Metí la pata.",
          "idiom: meter la pata."
        ],
        [
          "Hice caso a él.",
          "Le hice caso.",
          "hacer caso: indirect pronoun."
        ],
        [
          "Dejé de a fumar.",
          "Dejé de fumar.",
          "dejar de + infinitive."
        ],
