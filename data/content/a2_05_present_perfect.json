    {
      "type": "mistakes",
      "rows": [
        [
          "Ayer he comido paella.",
          "Ayer comí paella.",
          "ayer is a finished period: preterite."
        ],
        [
          "El año pasado he viajado a Italia.",
          "El año pasado viajé a Italia.",
          "el año pasado is finished: preterite."
        ],
        [
          "Ellos han comidos.",
          "Ellos han comido.",
          "The participle never agrees with the subject."
        ],
        [
          "He ya terminado.",
          "Ya he terminado.",
          "he and the participle are never separated."
        ],
        [
          "Yo soy ido a casa.",
          "Yo he ido a casa.",
          "Always haber, never ser, in the perfect."
        ],
        [
          "He hacido la cena.",
          "He hecho la cena.",
          "The participle of hacer is hecho."
        ],
        [
          "Ha dicido la verdad.",
          "Ha dicho la verdad.",
          "The participle of decir is dicho."
        ],
        [
          "Hemos escribido una carta.",
          "Hemos escrito una carta.",
          "The participle of escribir is escrito."
        ],
        [
          "He leido el libro.",
          "He leído el libro.",
          "Accent needed: leído, creído, oído, traído, caído."
        ]
      ]
