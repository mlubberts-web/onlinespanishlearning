      "type": "table",
      "style": "plain",
      "widths": [
        5.6,
        5.7,
        5.7
      ],
      "head": [
        "Question",
        "Present perfect",
        "Preterite"
      ],
      "rows": [
        [
          "Is the time period still open?",
          "Hoy he comido tarde.",
          "Ayer comí tarde."
        ],
        [
          "",
          "Este año he viajado a Italia.",
          "El año pasado viajé a Italia."
