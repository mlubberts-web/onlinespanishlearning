    {
      "type": "mistakes",
      "rows": [
        [
          "Me gusta mogollón esa canción.",
          "Me mola mucho esa canción.",
          "mogollón means a lot of things or people."
        ],
        [
          "Estoy hecho polvos.",
          "Estoy hecho polvo.",
          "fixed phrase, singular."
        ],
        [
          "Me tomas el cabello.",
          "Me tomas el pelo.",
          "the idiom uses pelo, not cabello."
        ],
        [
          "Meto el pie.",
          "Meto la pata.",
          "the idiom is meter la pata."
        ],
        [
          "Estoy sin blancas.",
          "Estoy sin blanca.",
          "fixed singular."
        ],
        [
          "Me da la latita.",
          "Me da la lata.",
          "fixed idiom, no diminutive."
        ],
        [
          "Me mola mucho su propuesta, señor director.",
          "Me parece muy interesante su propuesta.",
          "molar is colloquial: not for formal speech."
        ]
