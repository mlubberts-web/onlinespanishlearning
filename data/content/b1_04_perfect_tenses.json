    {
      "type": "h1",
      "text": "6. Common mistakes"
    },
    {
      "type": "mistakes",
      "rows": [
        [
          "Cuando llegué, ya salí.",
          "Cuando llegué, ya había salido.",
          "The earlier action takes the past perfect."
        ],
        [
          "Había comió.",
          "Había comido.",
          "The participle of -er verbs ends in -ido."
        ],
        [
          "Habíamos hacido.",
          "Habíamos hecho.",
          "The participle of hacer is hecho."
        ],
        [
          "Dijo que ha terminado.",
          "Dijo que había terminado.",
          "After a past verb of saying, use the past perfect."
        ],
        [
          "Para mañana he terminado.",
          "Para mañana habré terminado.",
          "A future deadline needs the future perfect."
        ],
        [
          "Espero que has llegado bien.",
          "Espero que hayas llegado bien.",
          "Espero que needs the subjunctive: hayas."
        ],
        [
          "Me alegro de que has venido.",
          "Me alegro de que hayas venido.",
          "Same rule: haya, hayas, haya ..."
        ],
        [
          "Habían ya salido.",
          "Ya habían salido.",
          "haber and the participle are never separated."
        ],
        [
          "Yo había vivir en Cuba.",
          "Yo había vivido en Cuba.",
          "The participle, not the infinitive, follows haber."
        ]
      ]
    },
