    {
      "type": "bullets",
      "items": [
        "<b>Colloquial</b>: contractions of speech, interjections, short sentences, <i>tío, guay, mola, vale, currar, pasta, flipar</i>.",
        "<b>Neutral</b>: standard vocabulary, clear sentences, tú or usted by context.",
        "<b>Formal / academic</b>: usted, impersonal se, passive, nominalisation, long sentences with connectors, hedging, no slang."
      ]
    },
