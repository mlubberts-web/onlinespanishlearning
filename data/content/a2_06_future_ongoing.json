    {
      "type": "callout",
      "kind": "tip",
      "title": "Only -ir verbs change in the gerund",
      "text": "<i>pensar</i> gives <b>pensando</b> and <i>volver</i> gives <b>volviendo</b> (no change), but <i>dormir</i> gives <b>durmiendo</b> and <i>pedir</i> gives <b>pidiendo</b>."
    },
